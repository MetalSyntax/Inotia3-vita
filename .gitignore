# ==============================================================================
# PROTECCIÓN CONTRA DMCA Y ARCHIVOS PROPIETARIOS
# ==============================================================================

# APK/ZIP originales y APK extraído completo (contiene el .so propietario del
# juego bajo lib/armeabi/) -- nunca commitear el juego. Regenerable por el
# usuario final a partir de su propia copia legal del APK.
*.apk
*.zip
*.obb
*.pak
*.pk3
/inotia3-1-3-2/

# No subir los assets o recursos originales (música, imágenes, datos, etc.)
/assets/
/res/
/lib/
*.mp3
*.ogg
*.wav
*.m4a
*.mp4

# Java decompilado con jadx (derivado de material propietario, regenerable con
# `jadx -d decompiled_apk inotia3-1-3-2.apk` -- ver PORTING_PLAN.md Fase 1)
/decompiled_apk/

# Pseudo-C del .so decompilado con Ghidra/devrvk-so-decompiler (derivado,
# regenerable -- ver PORTING_PLAN.md Fase 1)
/decompiled_so/

# Librerías dinámicas originales no deben subirse (salvo que sea el binario final generado localmente, pero mejor ser restrictivo)
*.so

# Capturas de pantalla del juego corriendo (in-game o de la app original) --
# muestran contenido con copyright de Com2uS directamente, mismo criterio que
# el resto de esta sección. Usadas puntualmente como referencia para medir
# coordenadas de UI (ver comentarios de source/wr_touch.c) pero no se suben.
2026-*.jpg
inotia-3-children-of-carnia_*.jpg

